<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.hengen.uiskipper">

    <application
        android:label="HyperOS UI Skipper"
        android:allowBackup="false">
        <!-- No launcher activity: this module is invisible on purpose. The mode
             switch lives in the flashable module's WebUI (ksu.exec runs as root
             there already), so the APK itself never needs a root grant. -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="Removes the 5/10 s wait on HyperOS SecurityCenter danger confirmation screens." />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposedscope" android:resource="@array/xposed_scope" />
    </application>
</manifest>
