# Set default behavior to force LF line endings for all text files across all platforms
* text=auto eol=lf

# Explicitly ensure Linux / Android scripts, workflows, and documentation stay pure LF
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.prop text eol=lf
*.json text eol=lf
*.md text eol=lf
gradlew text eol=lf
